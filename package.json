{
  "name": "alder-landing",
  "version": "1.0.0",
  "private": true,
  "description": "Single-file landing page prototype plus the image pipeline that feeds it.",
  "type": "module",
  "scripts": {
    "build": "node build-static.js index.html --out dist/index.html",
    "og": "node scripts/make-og-image.mjs",
    "icons": "node scripts/make-icons.mjs",
    "images": "node scripts/optimize-images.mjs",
    "images:force": "node scripts/optimize-images.mjs --force",
    "db:apply": "node scripts/apply-migrations.mjs",
    "bind": "node scripts/make-bind-code.mjs",
    "tg:commands": "node scripts/tg-commands.mjs set",
    "tg:commands:info": "node scripts/tg-commands.mjs info",
    "delete:lead": "node scripts/delete-lead.mjs",
    "offboard": "node scripts/offboard-business.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "libphonenumber-js": "^1.13.15"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "pg": "^8.23.1",
    "sharp": "^0.34.2",
    "ssim.js": "^3.5.0"
  }
}
