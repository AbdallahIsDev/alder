# Copy to .env and fill in. .env is gitignored; this file is the list of names only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
IP_HASH_SALT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
RESEND_API_KEY=
MAIL_FROM=
MAIL_REDIRECT_TO=
# optional demo-recordings switch: "off" skips the [TEST for ...] subject prefix only; recipients are still redirected
MAIL_REDIRECT_PREFIX=
SITE_URL=
# local migrations only, never set in Vercel
DATABASE_URL=
# test-only base URL overrides; honored ONLY in local development, never in a deployed function
RESEND_API_BASE=
TELEGRAM_API_BASE=
# test-only switches, never set in Vercel:
# TEST_ENV=1 makes the loader read .env.test first (process.env still wins)
# ALLOW_PROD_TESTS=1 lets the runner run against the project named in .env
TEST_ENV=
ALLOW_PROD_TESTS=
# per-business daily ceiling on customer auto-replies (owner email and Telegram are never capped)
AUTOREPLY_DAILY_CAP=
