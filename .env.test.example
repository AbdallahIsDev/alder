# .env.test.example — names for a dedicated TEST Supabase project.
#
# Copy to .env.test (gitignored) and fill in. Never put production values here.
# Run with:  TEST_ENV=1 node tests/run.mjs
#
# Names only in this file. `npm run test:env-check` tells you what is still missing
# and whether SUPABASE_URL is still pointing at production.
#
# DO NOT add TELEGRAM_API_BASE or RESEND_API_BASE here: the runner refuses to start
# if a file defines them, because a file value would shadow the loopback override
# that points the tests at the local fake servers.

# --- Supabase project (Dashboard -> Project Settings) -----------------------
# API Settings -> Project URL. Must be the TEST project, not production.
SUPABASE_URL=
# API Settings -> Project API keys -> "anon" / "public". Used by db-wall to prove
# the public key can read nothing.
SUPABASE_ANON_KEY=
# API Settings -> Project API keys -> "service_role" / "secret". Bypasses RLS; the
# suites use it to seed and assert rows. Never used by the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Connect -> Connection string -> "Session pooler" (URI). Needed only by
# `npm run db:apply`. Percent-encode the password.
DATABASE_URL=

# --- Values the tests need but that never leave this machine ---------------
# Any random string. Without it the lead endpoint answers 500 and db-wall E7 fails.
IP_HASH_SALT=
# Dummy. Every Telegram call goes to the local fake server during a test run.
TELEGRAM_BOT_TOKEN=
# Dummy numeric chat id. The demo business falls back to this when it has no
# bound chat, and test B1 asserts the alert was sent here.
TELEGRAM_CHAT_ID=
# Dummy. It is the shared secret the webhook tests present in the header.
TELEGRAM_WEBHOOK_SECRET=
# Dummy. Without it sendMail() returns missing_env instead of calling the fake.
RESEND_API_KEY=
# Any address on a domain that is NOT the built-in default sender, otherwise
# sendMail() answers no_verified_sender when no redirect is set.
MAIL_FROM=
# Any address. The suites assert that every recipient is redirected here, and the
# subject gets a "[TEST for ...]" prefix. Point it at a mailbox you own.
MAIL_REDIRECT_TO=
# Absolute base URL used to build the review link in emails. Any https URL.
SITE_URL=

# --- Optional ---------------------------------------------------------------
# Per-business daily ceiling on customer auto-replies (default 40). Tests set it
# per case; leave empty unless you want a different default.
AUTOREPLY_DAILY_CAP=
# Shared secret for /api/health and /api/selfcheck. The health suite sets it
# itself; only needed if you call the endpoints by hand against this project.
HEALTH_SECRET=
